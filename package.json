{
  "name": "konfide",
  "version": "0.1.0",
  "private": true,
  "description": "Konfide — confidential B2B cross-border payment protocol on Solana.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "biome format --write .",
    "check": "turbo run lint typecheck test",
    "e2e:kirapay": "tsx tooling/scripts/e2e-kirapay.ts",
    "kirapay:register-webhook": "tsx tooling/scripts/register-kirapay-webhook.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@konfide/adapter-kirapay": "workspace:^",
    "@types/node": "^22.19.18",
    "tsx": "^4.21.0",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6"
    }
  }
}
