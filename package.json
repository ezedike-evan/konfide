{
  "name": "konfide",
  "version": "0.1.0",
  "private": true,
  "description": "Konfide — confidential B2B cross-border payment protocol on Solana.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "biome format --write .",
    "check": "turbo run lint typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.19.18",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3"
  }
}
