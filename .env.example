# ─── Kirapay (sponsor: cross-border payment rails) ─────────────────────────────
KIRAPAY_API_KEY=                # Server-side API key from Kirapay dashboard.
KIRAPAY_BASE_URL=               # Optional override; defaults to https://api.kirapay.dev.
KIRAPAY_WEBHOOK_SECRET=         # HMAC secret used to verify Kirapay webhooks.

# ─── Magicblock (sponsor: confidential / ephemeral rollup execution) ───────────
MAGICBLOCK_API_KEY=             # API key for Magicblock infrastructure.
MAGICBLOCK_RPC_URL=             # RPC endpoint for Magicblock ephemeral rollup.

# ─── Covalent (sponsor: cross-chain on-chain history & analytics) ──────────────
COVALENT_API_KEY=               # API key for Covalent unified data API.

# ─── Torque (sponsor: on-chain loyalty & retention) ────────────────────────────
TORQUE_API_KEY=                 # API key for Torque retention primitives.

# ─── Privy (sponsor: auth + embedded wallets) ──────────────────────────────────
PRIVY_APP_ID=                   # Privy application ID (public).
PRIVY_APP_SECRET=               # Privy application secret (server-side only).

# ─── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=                 # Solana RPC endpoint (devnet/mainnet/local).
SOLANA_PAYER_KEYPAIR_PATH=      # Path to JSON keypair file used to pay fees.
SOLANA_DESTINATION_WALLET=      # Solana wallet that should receive USDC payouts.

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=                   # Postgres connection string for apps/api.

# ─── Konfide app ───────────────────────────────────────────────────────────────
PUBLIC_APP_URL=                 # e.g. http://localhost:3000; used for success/cancel URLs.
KONFIDE_ISSUER_HANDLE=          # Defaults to "konfide-demo" (seeded by db:seed).
NEXT_PUBLIC_API_URL=            # Web → API URL; defaults to http://localhost:3001.
