{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@konfide/config-tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "incremental": true
  },
  "include": [
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx"
  ],
  "exclude": ["node_modules", ".next"]
}
